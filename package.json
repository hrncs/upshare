{
  "name": "upshare",
  "version": "0.0.21",
  "description": "Official CLI for UpShare — upload, download, and manage your files securely via API key.",
  "keywords": [
    "upshare",
    "cli",
    "file-sharing",
    "upload",
    "download",
    "api"
  ],
  "homepage": "https://github.com/hrncs/upshare#readme",
  "bugs": {
    "url": "https://github.com/hrncs/upshare/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hrncs/upshare.git"
  },
  "license": "MIT",
  "author": "Himanshu Ranjan",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "upshare": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "ultracite check",
    "check-types": "tsc --noEmit",
    "fix": "ultracite fix",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prepublishOnly": "pnpm check && pnpm check-types && pnpm test && pnpm build",
    "test": "vitest run"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.0",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "ultracite": "7.12.0",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=20.11"
  }
}
